# ── Visual Search ────────────────────────────────────────────
# Python environments & cache
visualSearch/.venv/
visualSearch/venv/
visualSearch/__pycache__/
visualSearch/**/__pycache__/
visualSearch/**/*.pyc

# CLIP model weights (too large for GitHub — ~600MB)
# Downloaded automatically from HuggingFace on first boot
visualSearch/model/pytorch_model.bin
visualSearch/model/model.safetensors

# FAISS index & id_map (runtime-generated, persisted via DO Spaces)
visualSearch/faiss.index
visualSearch/id_map.json

# Secrets
visualSearch/.env

# Uploads / temp files
visualSearch/uploads/
visualSearch/tmp/

# Keep these model config files (small, required for CLIPProcessor)
!visualSearch/model/config.json
!visualSearch/model/tokenizer.json
!visualSearch/model/tokenizer_config.json
!visualSearch/model/vocab.json
!visualSearch/model/merges.txt
!visualSearch/model/special_tokens_map.json
!visualSearch/model/preprocessor_config.json
!visualSearch/model/preprocessor_config.json
# ─────────────────────────────────────────────────────────────

